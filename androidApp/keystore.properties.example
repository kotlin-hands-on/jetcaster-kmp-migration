# Copy to keystore.properties (not committed) to sign release builds.
# Paths are relative to this module directory, or absolute.
# To sign with the local Android debug key, as the Gradle build did when ~/.android/debug.keystore existed:
#   storeFile=/Users/<you>/.android/debug.keystore
#   storePassword=android
#   keyAlias=androiddebugkey
#   keyPassword=android
# Or with the committed debug_2.keystore (its passwords were read from the compose_* environment variables):
storeFile=../debug_2.keystore
storePassword=<compose_store_password>
keyAlias=<compose_key_alias>
keyPassword=<compose_key_password>
